\f0\fs24 \cf0 :root \{\
    --bg-dark-main: #0B0F19;\
    --bg-dark-card: #151D30;\
    --border-blueprint: #2D3D63;\
    --text-primary: #E2E8F0;\
    --text-muted: #94A3B8;\
    --color-green: #10B981;\
    --color-red: #EF4444;\
    --color-gold: #F59E0B;\
    --color-blue: #3B82F6;\
\}\
body \{ margin: 0; font-family: system-ui, -apple-system, sans-serif; background-color: var(--bg-dark-main); color: var(--text-primary); \}\
.app-container \{ max-width: 900px; margin: 0 auto; padding: 25px 15px; \}\
.app-header \{ text-align: center; border-bottom: 2px solid var(--border-blueprint); padding-bottom: 20px; margin-bottom: 25px; position: relative; \}\
.logo-area \{ display: flex; justify-content: center; align-items: center; gap: 12px; \}\
.logo-area h1 \{ margin: 0; font-size: 2.4rem; font-weight: 800; background: linear-gradient(to right, var(--color-blue), var(--color-green)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; \}\
.subtitle \{ color: var(--text-muted); font-size: 0.9rem; margin-top: 5px; \}\
.score-badge \{ position: absolute; top: 5px; right: 5px; background: rgba(59, 130, 246, 0.15); border: 1px solid var(--color-blue); padding: 8px 18px; border-radius: 30px; font-weight: 700; color: #60A5FA; \}\
.app-tabs \{ display: flex; gap: 10px; margin-bottom: 25px; \}\
.tab-btn \{ flex: 1; background: var(--bg-dark-card); border: 1px solid var(--border-blueprint); color: var(--text-muted); padding: 14px; font-size: 0.95rem; font-weight: 600; cursor: pointer; border-radius: 8px; transition: all 0.25s ease; \}\
.tab-btn.active, .tab-btn:hover \{ background: rgba(59, 130, 246, 0.08); border-color: var(--color-blue); color: white; box-shadow: 0 0 12px rgba(59, 130, 246, 0.25); \}\
.tab-section \{ display: none; \}\
.tab-section.active \{ display: block; \}\
.card \{ background: var(--bg-dark-card); border: 1px solid var(--border-blueprint); border-radius: 12px; padding: 24px; margin-bottom: 20px; \}\
.card h2 \{ margin-top: 0; font-size: 1.3rem; color: white; \}\
.card-desc \{ color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px; \}\
textarea \{ width: 100%; height: 130px; background: var(--bg-dark-main); border: 1px solid var(--border-blueprint); border-radius: 8px; padding: 14px; color: white; font-size: 0.95rem; resize: none; box-sizing: border-box; margin-bottom: 15px; outline: none; \}\
.btn-primary \{ background: var(--color-blue); color: white; border: none; padding: 14px; font-size: 1rem; font-weight: 700; border-radius: 8px; cursor: pointer; width: 100%; \}\
.btn-primary:hover \{ background: #2563EB; \}\
.sample-buttons \{ display: flex; gap: 8px; margin-bottom: 15px; \}\
.sample-buttons button \{ background: #1E293B; border: 1px solid var(--border-blueprint); color: var(--text-primary); padding: 8px 14px; border-radius: 6px; font-size: 0.85rem; cursor: pointer; \}\
.hidden \{ display: none !important; \}\
.result-box \{ margin-top: 20px; padding: 18px; border-radius: 8px; border-left: 5px solid; \}\
.danger-zone \{ background: rgba(239, 68, 68, 0.08); border-color: var(--color-red); \}\
.safe-zone \{ background: rgba(16, 185, 129, 0.08); border-color: var(--color-green); \}\
.progress-bar-container \{ background: var(--bg-dark-main); height: 8px; border-radius: 4px; margin-bottom: 20px; \}\
.progress-bar \{ background: var(--color-green); height: 100%; border-radius: 4px; transition: width 0.3s; \}\
.rules-grid \{ display: grid; grid-template-columns: 1fr 1fr; gap: 15px; \}\
.rule-item \{ background: var(--bg-dark-main); padding: 16px; border-radius: 8px; border: 1px solid var(--border-blueprint); font-size: 0.9rem; \}\
.rescue-table \{ width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.9rem; \}\
.rescue-table th, .rescue-table td \{ border: 1px solid var(--border-blueprint); padding: 12px; text-align: left; \}\
.rescue-table th \{ background: var(--bg-dark-main); \}\
.badge-box \{ background: rgba(245, 158, 11, 0.08); border: 1px solid var(--color-gold); padding: 16px; border-radius: 8px; text-align: center; margin-top: 25px; color: var(--color-gold); font-weight: 600; \}\
@media (max-width: 768px) \{ .rules-grid \{ grid-template-columns: 1fr; \} .app-tabs \{ flex-direction: column; \} .score-badge \{ position: static; margin-bottom: 15px; display: inline-block; \} .sample-buttons \{ flex-direction: column; \} \}}